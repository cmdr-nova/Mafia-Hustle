# Copy this file to .env and fill it in. Never commit .env.

# Signs login cookies. Generate one with:
#   python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY=

# Optional. Defaults to a SQLite file in the instance/ folder.
# DATABASE_URL=sqlite:///mafia_hustle.db

# Optional for local development, required in production for Bluesky logins.
# The public https address of the game, no trailing slash.
# PUBLIC_URL=https://hustle.example.com
