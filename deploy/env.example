# Lives at /etc/mafia-hustle/env on the server (owner root, group mafia-hustle, mode 640).

# Generate with: python3 -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY=

# The public address. Bluesky servers fetch PUBLIC_URL/oauth/client-metadata.json.
PUBLIC_URL=https://hustle.mkultra.monster

# The database lives here, outside the code folder.
INSTANCE_PATH=/var/lib/mafia-hustle

# One reverse proxy (Caddy) sits in front, so trust one X-Forwarded-For hop.
TRUST_PROXY=1
