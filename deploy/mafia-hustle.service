# Install: sudo cp deploy/mafia-hustle.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now mafia-hustle
[Unit]
Description=Mafia Hustle
After=network-online.target
Wants=network-online.target

[Service]
User=mafia-hustle
Group=mafia-hustle
WorkingDirectory=/opt/mafia-hustle
EnvironmentFile=/etc/mafia-hustle/env
RuntimeDirectory=mafia-hustle
ExecStart=/opt/mafia-hustle/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8730 \
    --pid /run/mafia-hustle/gunicorn.pid \
    --access-logfile - \
    wsgi:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

# Sandboxing: the game can only write to its data folder, and can't see anything else
# that lives on the box (the website, the PDS, home folders).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mafia-hustle
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
